# Agent Games Gatekeeper — copy to .env and fill in. NEVER commit .env.
# AGENT_GAMES_HMAC_SECRET: 32-byte secret shown ONCE when the agent is
# registered in the Agent Games dashboard. Rotate there if it leaks.
AGENT_GAMES_HMAC_SECRET=
# KURIER_API_KEY: mainnet API key from kurier.xyz dashboard (40 chars).
KURIER_API_KEY=
# Local dev server port (npm start). Vercel ignores this.
AGENT_GAMES_PORT=3000
# Optional: taskId field mapping for the circuit ("keccak" default,
# "numeric" or "hex" — see src/agent-games/prove.mjs).
# GATEKEEPER_TASK_ID_MODE=keccak
